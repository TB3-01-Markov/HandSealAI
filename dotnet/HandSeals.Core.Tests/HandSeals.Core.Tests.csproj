<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Unity EditMode tests of the core with plain `dotnet test`, no Unity needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>HandSeals.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Tests\EditMode\**\*.cs" LinkBase="Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3.x, the same major version as the Unity Test Framework uses. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandSeals.Core\HandSeals.Core.csproj" />
  </ItemGroup>

</Project>
