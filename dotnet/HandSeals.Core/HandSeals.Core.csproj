<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the game core outside Unity from the very same source files.
    Target and language version match what Unity 6 compiles with, so anything that builds here builds there.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>HandSeals.Core</RootNamespace>
    <AssemblyName>HandSeals.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
